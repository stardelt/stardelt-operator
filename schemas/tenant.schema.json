{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "A tenant: an isolation boundary for data and identities.",
  "properties": {
    "spec": {
      "description": "Namespaced isolation boundary: a tenant's data and identities.",
      "properties": {
        "displayName": {
          "nullable": true,
          "type": "string"
        },
        "profile": {
          "default": "demo",
          "description": "Deployment size / capability profile.",
          "enum": [
            "demo",
            "full",
            "airgap"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "status": {
      "nullable": true,
      "properties": {
        "conditions": {
          "default": [],
          "items": {
            "properties": {
              "lastTransitionTime": {
                "nullable": true,
                "type": "string"
              },
              "message": {
                "nullable": true,
                "type": "string"
              },
              "observedGeneration": {
                "format": "int64",
                "nullable": true,
                "type": "integer"
              },
              "reason": {
                "nullable": true,
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "type"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "observedGeneration": {
          "format": "int64",
          "nullable": true,
          "type": "integer"
        },
        "phase": {
          "default": "",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "spec"
  ],
  "title": "Tenant",
  "type": "object"
}
